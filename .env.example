MINIO_ROOT_USER=replace-with-your-minio-user
MINIO_ROOT_PASSWORD=replace-with-a-long-random-password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=healthy-agent-knowledge

AGENT_DB_PORT=3306
AGENT_DB_NAME=healthy_agent
AGENT_DB_USERNAME=healthy_agent
AGENT_DB_PASSWORD=replace-with-a-long-random-password

AGENT_WEB_PORT=8090
# local-dev keeps the optional in-memory login buttons enabled. Real Healthy
# login is independently proxied through HEALTHY_API_UPSTREAM below.
AGENT_SECURITY_MODE=local-dev
AGENT_API_UPSTREAM=agent-backend:8091
# Cloud Healthy monolith used for /api/auth/** and future business Tools.
# Plain HTTP is only acceptable for demo accounts; use a domain with HTTPS later.
HEALTHY_API_UPSTREAM=8.137.98.235:80
# Agent backend uses the same Healthy deployment for fixed patient Tools.
AGENT_HEALTHY_API_BASE_URL=http://8.137.98.235
AGENT_HEALTHY_API_CONNECT_TIMEOUT=2s
AGENT_HEALTHY_API_READ_TIMEOUT=5s
NACOS_SERVER_ADDR=host.docker.internal:8848
NACOS_DISCOVERY_ENABLED=false
AGENT_DISCOVERY_IP=127.0.0.1
NACOS_CONFIG_ENABLED=false
ELASTICSEARCH_PORT=9200
KIBANA_PORT=5601
ES_JAVA_OPTS=-Xms512m -Xmx512m

# SiliconFlow BGE-M3 embedding. Keep the real key only in the ignored .env file.
AGENT_EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
AGENT_EMBEDDING_API_KEY=
AGENT_EMBEDDING_MODEL=BAAI/bge-m3
AGENT_EMBEDDING_DIMENSIONS=1024
AGENT_EMBEDDING_BATCH_SIZE=16
AGENT_EMBEDDING_CONNECT_TIMEOUT=5s
AGENT_EMBEDDING_READ_TIMEOUT=60s

# DeepSeek generation. Keep the real key only in the ignored .env file.
AGENT_LLM_BASE_URL=https://api.deepseek.com
AGENT_LLM_API_KEY=
AGENT_LLM_MODEL=deepseek-flash
AGENT_LLM_MAX_OUTPUT_TOKENS=600
AGENT_LLM_TEMPERATURE=0.2
AGENT_LLM_CONNECT_TIMEOUT=5s
AGENT_LLM_READ_TIMEOUT=90s
AGENT_TOOL_MAX_CALLS_PER_TOOL=30
AGENT_TOOL_MAX_TOTAL_CALLS=60

# RAG retrieval and context limits.
AGENT_RAG_DEFAULT_TOP_K=5
AGENT_RAG_MAX_TOP_K=8
AGENT_RAG_MIN_SCORE=0.65
AGENT_RAG_MAX_CONTEXT_CHARACTERS=6000

TZ=Asia/Shanghai
