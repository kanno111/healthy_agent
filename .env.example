MINIO_ROOT_USER=replace-with-your-minio-user
MINIO_ROOT_PASSWORD=replace-with-a-long-random-password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=healthy-agent-knowledge

AGENT_DB_PORT=3306
AGENT_DB_NAME=healthy_agent
AGENT_DB_USERNAME=healthy_agent
AGENT_DB_PASSWORD=replace-with-a-long-random-password

AGENT_WEB_PORT=8090
NACOS_SERVER_ADDR=host.docker.internal:8848
NACOS_DISCOVERY_ENABLED=false
AGENT_DISCOVERY_IP=127.0.0.1
NACOS_CONFIG_ENABLED=false
ELASTICSEARCH_PORT=9200
KIBANA_PORT=5601
ES_JAVA_OPTS=-Xms512m -Xmx512m

# SiliconFlow BGE-M3 embedding. Keep the real key only in the ignored .env file.
AGENT_EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
AGENT_EMBEDDING_API_KEY=
AGENT_EMBEDDING_MODEL=BAAI/bge-m3
AGENT_EMBEDDING_DIMENSIONS=1024
AGENT_EMBEDDING_BATCH_SIZE=16
AGENT_EMBEDDING_CONNECT_TIMEOUT=5s
AGENT_EMBEDDING_READ_TIMEOUT=60s

TZ=Asia/Shanghai
